# =================================================================
# STUDENT PERFORMANCE PREDICTION - ENVIRONMENT CONFIGURATION
# =================================================================

# -----------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel / Local Vite)
# -----------------------------------------------------------------
# The public base URL of the FastAPI backend.
# Local Development:  http://127.0.0.1:8000
# Production (Vercel): https://your-backend-service.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000


# -----------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render / Local Python)
# -----------------------------------------------------------------
# Server Port (Render sets this dynamically via $PORT)
PORT=8000

# Allowed Frontend URL for CORS Security
# Local Development:  http://localhost:5173
# Production (Render): https://your-frontend-app.vercel.app
FRONTEND_URL=http://localhost:5173


# -----------------------------------------------------------------
# 3. WEATHER MODULE CONFIGURATION (Open-Meteo)
# -----------------------------------------------------------------
# Open-Meteo endpoints (Free & No API Key Required)
WEATHER_PROVIDER=open_meteo
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# Open-Meteo does not require an API key
WEATHER_API_KEY=
